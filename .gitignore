*.tsbuildinfo
next-env.d.ts

# Playwright MCP: ảnh chụp và bản dump trang gốc (dữ liệu tạm)
/.playwright-mcp/

# Repo skill clone riêng (đã copy skill cần dùng vào .claude/skills)
/ClaudeMD/

# Cấu hình Claude Code cá nhân
.claude/settings.local.json
